
{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Product categories like Dresses, Skirts, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Product": {
      "title": "Product",
      "description": "Fashion product with variants and stock management.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "categoryId": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "variants": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "size": { "type": "string" },
              "stock": { "type": "number" },
              "sku": { "type": "string" }
            }
          }
        },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "categoryId"]
    },
    "Settings": {
      "title": "Store Settings",
      "description": "Global configuration for the brand.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string" },
            "tiktok": { "type": "string" },
            "facebook": { "type": "string" },
            "snapchat": { "type": "string" }
          }
        },
        "deliveryFees": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "lowStockThreshold": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Fashion products with variant stock."
    },
    "/settings/general": {
      "schema": "Settings",
      "description": "Global store settings."
    }
  }
}
