
{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Store configuration and subscription data.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "whatsapp": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "trial"] }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product categories for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean", "default": true },
        "storeId": { "type": "string" }
      },
      "required": ["name", "slug", "storeId"]
    },
    "Product": {
      "title": "Product",
      "description": "Fashion product with variants and stock management for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "material": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "variants": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "size": { "type": "string" },
              "stock": { "type": "number" }
            }
          }
        },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "storeId": { "type": "string" }
      },
      "required": ["name", "price", "categoryId", "storeId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details for NOVA.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "province": { "type": "string" },
            "address": { "type": "string" }
          }
        },
        "items": { "type": "array", "items": { "type": "object" } },
        "totals": { "type": "object" },
        "status": { "type": "string" },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Global store settings for NOVA.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "deliveryFees": { "type": "object" }
      }
    },
    "DeliveryCompany": {
      "title": "Delivery Company",
      "description": "Logistics providers for shipping orders.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "PUBLIC_READ: Publicly accessible store metadata."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "PUBLIC_READ: Publicly accessible categories for the storefront."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "PUBLIC_READ: Publicly accessible products for the storefront."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "PUBLIC_CREATE/ADMIN_READ: Public can submit orders, only admins can view or update them."
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "PUBLIC_READ: Global store settings accessible by everyone."
    },
    "/delivery-companies/{companyId}": {
      "schema": "DeliveryCompany",
      "description": "ADMIN_ONLY: Only admins can manage delivery service providers."
    }
  }
}
