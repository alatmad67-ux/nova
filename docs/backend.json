
{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Store configuration and subscription data.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "whatsapp": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "trial"] }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product categories like Dresses, Skirts, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean", "default": true }
      },
      "required": ["name", "slug"]
    },
    "Product": {
      "title": "Product",
      "description": "Fashion product with variants and stock management.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "material": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "code": { "type": "string" }
            }
          }
        },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "variants": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "size": { "type": "string" },
              "stock": { "type": "number" },
              "sku": { "type": "string" },
              "barcode": { "type": "string" }
            }
          }
        },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "isNew": { "type": "boolean", "default": false },
        "isBestSeller": { "type": "boolean", "default": false },
        "isFeatured": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" },
        "storeId": { "type": "string" }
      },
      "required": ["name", "price", "categoryId", "storeId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "province": { "type": "string" },
            "region": { "type": "string" },
            "address": { "type": "string" },
            "landmark": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" },
              "color": { "type": "string" },
              "size": { "type": "string" },
              "sku": { "type": "string" }
            }
          }
        },
        "totals": {
          "type": "object",
          "properties": {
            "subtotal": { "type": "number" },
            "shipping": { "type": "number" },
            "discount": { "type": "number" },
            "total": { "type": "number" }
          }
        },
        "status": { "type": "string", "enum": ["جديد", "تم التأكيد", "قيد التجهيز", "جاهز للشحن", "مع شركة التوصيل", "تم التسليم", "ملغي", "مرتجع"] },
        "shippingInfo": {
          "type": "object",
          "properties": {
            "companyId": { "type": "string" },
            "companyName": { "type": "string" },
            "trackingNumber": { "type": "string" },
            "status": { "type": "string", "enum": ["لم يتم الشحن", "جاهز للشحن", "تم تسليمه لشركة التوصيل", "قيد التوصيل", "تم التسليم", "فشل التسليم", "مرتجع"] }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "storeId": { "type": "string" }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user profile and roles.",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "merchant"] },
        "storeId": { "type": "string" }
      }
    },
    "DeliveryCompany": {
      "title": "DeliveryCompany",
      "description": "Shipping and delivery company details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "apiUrl": { "type": "string" },
        "apiKey": { "type": "string" },
        "apiSecret": { "type": "string" },
        "isActive": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Global store settings like delivery fees and contact info.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "socialLinks": { "type": "object" },
        "deliveryFees": { "type": "object" },
        "lowStockThreshold": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password", "phone"]
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "PUBLIC_READ: Publicly accessible store metadata."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "PUBLIC_READ: Publicly accessible categories for visitors."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "PUBLIC_READ: Publicly accessible products for visitors."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "RESTRICTED: Accessible only to admins or the owner of the order."
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "ADMIN_ONLY: Strictly restricted to administrative users."
    },
    "/delivery-companies/{companyId}": {
      "schema": "DeliveryCompany",
      "description": "ADMIN_ONLY: Administrative access only."
    },
    "/settings/general": {
      "schema": "Settings",
      "description": "PUBLIC_READ: Publicly accessible settings."
    }
  }
}
