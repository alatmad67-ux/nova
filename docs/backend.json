
{
  "entities": {
    "Store": {
      "title": "Store Settings",
      "description": "Global configuration for NOVA store.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "logo": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" },
        "snapchat": { "type": "string" },
        "telegram": { "type": "string" },
        "deliveryFees": { "type": "object" },
        "lowStockThreshold": { "type": "number", "default": 5 },
        "returnPolicy": { "type": "string" },
        "storeId": { "type": "string" }
      }
    },
    "SliderItem": {
      "title": "Slider Item",
      "description": "Items for the homepage hero slider.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "storeId": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Fashion categories for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean", "default": true },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "storeId"]
    },
    "Product": {
      "title": "Product",
      "description": "Fashion product with advanced variant and stock management.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "material": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "variants": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "categoryId", "storeId"]
    },
    "DeliveryCompany": {
      "title": "Delivery Company",
      "description": "Logistics partner configuration for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "apiUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "storeId": { "type": "string" }
      },
      "required": ["name", "storeId"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "PUBLIC READ. ALLOW CREATE, UPDATE, DELETE ONLY FOR AUTHENTICATED ADMIN (07858833838@novafashion.iq). RULES_VERSION_70"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "PUBLIC READ. ALLOW CREATE, UPDATE, DELETE ONLY FOR AUTHENTICATED ADMIN (07858833838@novafashion.iq). RULES_VERSION_70"
    },
    "/orders/{orderId}": {
      "schema": "object",
      "description": "PUBLIC CREATE ACCESS. ALLOW READ, UPDATE, DELETE ONLY FOR AUTHENTICATED ADMIN (07858833838@novafashion.iq). RULES_VERSION_70"
    },
    "/settings/{settingId}": {
      "schema": "Store",
      "description": "PUBLIC READ. ALLOW CREATE, UPDATE, DELETE ONLY FOR AUTHENTICATED ADMIN (07858833838@novafashion.iq). RULES_VERSION_70"
    },
    "/sliders/{sliderId}": {
      "schema": "SliderItem",
      "description": "PUBLIC READ. ALLOW CREATE, UPDATE, DELETE ONLY FOR AUTHENTICATED ADMIN (07858833838@novafashion.iq). RULES_VERSION_70"
    },
    "/delivery-companies/{companyId}": {
      "schema": "DeliveryCompany",
      "description": "ALLOW READ, CREATE, UPDATE, DELETE ONLY FOR AUTHENTICATED ADMIN (07858833838@novafashion.iq). NO PUBLIC ACCESS. RULES_VERSION_70"
    }
  }
}
