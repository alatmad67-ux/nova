{
  "entities": {
    "Store": {
      "title": "Store Settings",
      "description": "Global configuration for NOVA store.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "logo": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" },
        "snapchat": { "type": "string" },
        "telegram": { "type": "string" },
        "deliveryFees": { "type": "object" },
        "lowStockThreshold": { "type": "number", "default": 5 },
        "returnPolicy": { "type": "string" },
        "storeId": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Fashion categories for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean", "default": true },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "storeId"]
    },
    "Product": {
      "title": "Product",
      "description": "Fashion product with advanced variant and stock management.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "material": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discount": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "object" } },
        "selectedSizes": { "type": "array", "items": { "type": "string" } },
        "variants": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "size": { "type": "string" },
              "stock": { "type": "number" },
              "sku": { "type": "string" }
            }
          }
        },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "isNew": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "categoryId", "storeId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details for NOVA.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "province": { "type": "string" },
            "region": { "type": "string" },
            "address": { "type": "string" },
            "landmark": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "items": { "type": "array", "items": { "type": "object" } },
        "totals": { 
          "type": "object",
          "properties": {
            "subtotal": { "type": "number" },
            "shipping": { "type": "number" },
            "discount": { "type": "number" },
            "total": { "type": "number" }
          }
        },
        "status": { "type": "string" },
        "shippingInfo": { "type": "object" },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Customer": {
      "title": "Customer",
      "description": "Unified customer profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "province": { "type": "string" },
        "orderCount": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "lastOrder": { "type": "string" },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "PUBLIC_READ: Everyone. ADMIN_WRITE: Only 07858833838@novafashion.iq. Index: storeId ASC, order ASC."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "PUBLIC_READ: Everyone. ADMIN_WRITE: Only 07858833838@novafashion.iq. Index: storeId ASC, createdAt DESC."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "PUBLIC_CREATE: Customers. ADMIN_READ_WRITE: Only 07858833838@novafashion.iq. Index: storeId ASC, createdAt DESC."
    },
    "/settings/{settingId}": {
      "schema": "Store",
      "description": "PUBLIC_READ: Everyone. ADMIN_WRITE: Only 07858833838@novafashion.iq."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "ADMIN_ONLY: Only 07858833838@novafashion.iq."
    },
    "/delivery-companies/{companyId}": {
      "schema": "DeliveryCompany",
      "description": "ADMIN_ONLY: Only 07858833838@novafashion.iq."
    }
  }
}
