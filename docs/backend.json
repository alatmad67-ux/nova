
{
  "entities": {
    "Store": {
      "title": "Store Settings",
      "description": "Global configuration for NOVA store.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "logo": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" },
        "snapchat": { "type": "string" },
        "telegram": { "type": "string" },
        "deliveryFees": { "type": "object" },
        "lowStockThreshold": { "type": "number", "default": 5 },
        "returnPolicy": { "type": "string" },
        "storeId": { "type": "string" }
      }
    },
    "SliderItem": {
      "title": "Slider Item",
      "description": "Items for the homepage hero slider.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "storeId": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Fashion categories for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean", "default": true },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "storeId"]
    },
    "Product": {
      "title": "Product",
      "description": "Fashion product with advanced variant and stock management.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "material": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discount": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "object" } },
        "selectedSizes": { "type": "array", "items": { "type": "string" } },
        "variants": { 
          "type": "array", 
          "items": {
            "object": {
              "properties": {
                "color": { "type": "string" },
                "size": { "type": "string" },
                "stock": { "type": "number" },
                "sku": { "type": "string" }
              }
            }
          }
        },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "isNew": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "categoryId", "storeId"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Public READ. FULL WRITE (create, update, delete) for authenticated admin 07858833838@novafashion.iq only."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public READ. FULL WRITE (create, update, delete) for authenticated admin 07858833838@novafashion.iq only."
    },
    "/orders/{orderId}": {
      "schema": "object",
      "description": "Public CREATE only. FULL READ and WRITE (list, update, delete) for authenticated admin 07858833838@novafashion.iq only."
    },
    "/settings/{settingId}": {
      "schema": "Store",
      "description": "Public READ. FULL WRITE (create, update, delete) for authenticated admin 07858833838@novafashion.iq only."
    },
    "/sliders/{sliderId}": {
      "schema": "SliderItem",
      "description": "Public READ. FULL WRITE (create, update, delete) for authenticated admin 07858833838@novafashion.iq only."
    },
    "/delivery-companies/{companyId}": {
      "schema": "object",
      "description": "Private. No public access. FULL READ and WRITE for authenticated admin 07858833838@novafashion.iq only."
    }
  }
}
