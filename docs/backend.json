
{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Store configuration and subscription data.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "whatsapp": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "trial"] }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product categories for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean", "default": true },
        "storeId": { "type": "string" }
      },
      "required": ["name", "slug", "storeId"]
    },
    "Product": {
      "title": "Product",
      "description": "Fashion product with variants and stock management for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "material": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "code": { "type": "string" }
            }
          }
        },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "variants": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "size": { "type": "string" },
              "stock": { "type": "number" },
              "sku": { "type": "string" },
              "barcode": { "type": "string" }
            }
          }
        },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "isNew": { "type": "boolean", "default": false },
        "isBestSeller": { "type": "boolean", "default": false },
        "isFeatured": { "type": "boolean", "default": false },
        "storeId": { "type": "string" }
      },
      "required": ["name", "price", "categoryId", "storeId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details for NOVA.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "province": { "type": "string" },
            "region": { "type": "string" },
            "address": { "type": "string" },
            "landmark": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" },
              "color": { "type": "string" },
              "size": { "type": "string" },
              "sku": { "type": "string" }
            }
          }
        },
        "totals": {
          "type": "object",
          "properties": {
            "subtotal": { "type": "number" },
            "shipping": { "type": "number" },
            "discount": { "type": "number" },
            "total": { "type": "number" }
          }
        },
        "status": { "type": "string" },
        "storeId": { "type": "string" }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Global store settings for NOVA.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "deliveryFees": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "PUBLIC_READ: Publicly accessible store metadata."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "PUBLIC_READ: Publicly accessible categories for visitors."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "PUBLIC_READ: Publicly accessible products for visitors."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "PUBLIC_WRITE/ADMIN_READ: Allow public create, only admin can read."
    },
    "/settings/general": {
      "schema": "Settings",
      "description": "PUBLIC_READ: Publicly accessible settings."
    }
  }
}
