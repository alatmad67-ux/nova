{
  "entities": {
    "Store": {
      "title": "Store Settings",
      "description": "Global configuration for NOVA store.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "logo": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" },
        "snapchat": { "type": "string" },
        "telegram": { "type": "string" },
        "deliveryFees": { "type": "object" },
        "lowStockThreshold": { "type": "number", "default": 5 },
        "returnPolicy": { "type": "string" },
        "storeId": { "type": "string" }
      }
    },
    "CustomerProfile": {
      "title": "Customer Profile",
      "description": "User profile data for shoppers.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string" },
        "storeId": { "type": "string", "default": "nova-official" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Address": {
      "title": "Shipping Address",
      "description": "Customer delivery address.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "enum": ["المنزل", "العمل", "أخرى"] },
        "governorate": { "type": "string" },
        "area": { "type": "string" },
        "street": { "type": "string" },
        "nearestLandmark": { "type": "string" },
        "notes": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "storeId": { "type": "string" }
      }
    },
    "ShippingRate": {
      "title": "Shipping Rate",
      "description": "Delivery price per Iraqi governorate.",
      "type": "object",
      "properties": {
        "governorate": { "type": "string" },
        "price": { "type": "number" },
        "isActive": { "type": "boolean" },
        "storeId": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Fashion categories for NOVA.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean", "default": true },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "storeId"]
    },
    "Product": {
      "title": "Product",
      "description": "Fashion product with advanced variant and stock management.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "material": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "variants": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "categoryId", "storeId"]
    }
  },
  "auth": {
    "providers": ["google", "apple", "phone", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "CustomerProfile",
      "description": "OWNER_READ_WRITE: allow read, write if request.auth.uid == userId. ADMIN: allow all. VERSION_87"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": "Address",
      "description": "OWNER_READ_WRITE: allow read, write if request.auth.uid == userId. VERSION_87"
    },
    "/users/{userId}/favorites/{productId}": {
      "schema": "object",
      "description": "OWNER_READ_WRITE: allow read, write if request.auth.uid == userId. VERSION_87"
    },
    "/shipping-rates/{rateId}": {
      "schema": "ShippingRate",
      "description": "PUBLIC_READ: allow read. ADMIN: allow write. VERSION_87"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "PUBLIC_READ: allow get, list. ADMIN: allow write. VERSION_87"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "PUBLIC_READ: allow get, list. ADMIN: allow write. VERSION_87"
    },
    "/orders/{orderId}": {
      "schema": "object",
      "description": "AUTH_CREATE: allow create if request.auth != null. OWNER_READ: allow read if resource.data.customerId == request.auth.uid. ADMIN: allow all. VERSION_87"
    },
    "/notifications/{notificationId}": {
      "schema": "object",
      "description": "OWNER_READ: allow read if resource.data.userId == request.auth.uid. VERSION_87"
    },
    "/sliders/{sliderId}": {
      "schema": "object",
      "description": "PUBLIC_READ: allow read. ADMIN: allow write. VERSION_87"
    },
    "/delivery-companies/{companyId}": {
      "schema": "object",
      "description": "ADMIN: allow all. VERSION_87"
    },
    "/settings/general": {
      "schema": "Store",
      "description": "PUBLIC_READ: allow read. ADMIN: allow write. VERSION_87"
    }
  }
}
