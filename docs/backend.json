{
  "entities": {
    "Store": {
      "title": "Store Settings",
      "description": "Global configuration for NOVA store.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "logo": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" },
        "snapchat": { "type": "string" },
        "telegram": { "type": "string" },
        "deliveryFees": { "type": "object" },
        "lowStockThreshold": { "type": "number", "default": 5 },
        "returnPolicy": { "type": "string" },
        "storeId": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product category grouping.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "order": { "type": "number" },
        "mainCategory": { 
          "type": "string", 
          "enum": ["fashion", "accessories", "skincare", "beauty-devices"] 
        },
        "isActive": { "type": "boolean" },
        "storeId": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Product items in the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "mainCategory": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "sku": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "draft"] },
        "brand": { "type": "string" },
        "material": { "type": "string" },
        "ingredients": { "type": "string" },
        "howToUse": { "type": "string" },
        "specifications": { "type": "string" },
        "variants": { "type": "array" },
        "storeId": { "type": "string" },
        "isNew": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" }
      }
    },
    "CustomerProfile": {
      "title": "Customer Profile",
      "description": "User profile data for shoppers.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string" },
        "storeId": { "type": "string", "default": "nova-official" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Address": {
      "title": "Shipping Address",
      "description": "Customer delivery address.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "enum": ["المنزل", "العمل", "أخرى"] },
        "governorate": { "type": "string" },
        "area": { "type": "string" },
        "street": { "type": "string" },
        "nearestLandmark": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "storeId": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app alerts for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string" },
        "orderId": { "type": "string" },
        "isRead": { "type": "boolean", "default": false },
        "storeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DeliveryCompany": {
      "title": "Delivery Company",
      "description": "Logistics partner configuration.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "apiUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "storeId": { "type": "string" }
      }
    },
    "ShippingRate": {
      "title": "Shipping Rate",
      "description": "Delivery fees per governorate.",
      "type": "object",
      "properties": {
        "governorate": { "type": "string" },
        "price": { "type": "number" },
        "isActive": { "type": "boolean" },
        "storeId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google", "apple", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "CustomerProfile",
      "description": "OWNER_READ_WRITE"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": "Address",
      "description": "OWNER_READ_WRITE"
    },
    "/users/{userId}/favorites/{productId}": {
      "schema": "object",
      "description": "OWNER_READ_WRITE"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "PUBLIC_READ, ADMIN_WRITE"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "PUBLIC_READ, ADMIN_WRITE"
    },
    "/orders/{orderId}": {
      "schema": "object",
      "description": "AUTH_CREATE, OWNER_READ, ADMIN_ALL"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "OWNER_READ"
    },
    "/sliders/{sliderId}": {
      "schema": "object",
      "description": "PUBLIC_READ, ADMIN_WRITE"
    },
    "/settings/general": {
      "schema": "Store",
      "description": "PUBLIC_READ, ADMIN_WRITE"
    },
    "/delivery-companies/{companyId}": {
      "schema": "DeliveryCompany",
      "description": "ADMIN_ALL"
    },
    "/shipping-rates/{rateId}": {
      "schema": "ShippingRate",
      "description": "PUBLIC_READ, ADMIN_WRITE"
    }
  }
}